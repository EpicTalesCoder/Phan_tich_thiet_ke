    {
      "id": "SC_UC01_ThemMatHang",
      "type": "use_case_scenario",
      "title": "Kịch bản Thêm mặt hàng mới vào danh sách Mặt hàng",
      "format": "png",
      "data": {
        "id": "UC-THem-MH",
        "useCase": "Thêm mặt hàng mới vào danh sách Mặt hàng",
        "actor": "Nhân viên",
        "preconditions": [
          "Nhân viên đã đăng nhập vào hệ thống QLBH",
          "Nhân viên có quyền cập nhật danh sách Mặt hàng"
        ],
        "mainFlow": [
          "Nhân viên chọn chức năng Cập nhật danh sách Mặt hàng.",
          "Hệ thống hiển thị danh sách Mặt hàng hiện có.",
          "Nhân viên chọn Thêm mặt hàng mới.",
          "Hệ thống hiển thị form nhập thông tin mặt hàng.",
          "Nhân viên nhập mã, tên, đơn vị tính, giá bán và tồn kho ban đầu.",
          "Nhân viên xác nhận lưu mặt hàng mới.",
          "Hệ thống kiểm tra dữ liệu nhập và mã mặt hàng chưa tồn tại.",
          "Hệ thống lưu mặt hàng mới và cập nhật danh sách.",
          "Hệ thống hiển thị thông báo thêm mặt hàng thành công."
        ],
        "alternativeFlows": [
          {
            "name": "Dữ liệu nhập không hợp lệ",
            "steps": [
              "Tại bước 7, hệ thống phát hiện dữ liệu bắt buộc thiếu hoặc giá trị không hợp lệ.",
              "Hệ thống hiển thị thông báo lỗi và yêu cầu nhập lại.",
              "Quay lại bước 5."
            ]
          },
          {
            "name": "Mã mặt hàng đã tồn tại",
            "steps": [
              "Tại bước 7, hệ thống phát hiện mã mặt hàng đã tồn tại.",
              "Hệ thống hiển thị thông báo trùng mã và không lưu bản ghi mới.",
              "Quay lại bước 5."
            ]
          },
          {
            "name": "Nhân viên không có quyền",
            "steps": [
              "Tại bước 1, hệ thống xác nhận nhân viên không có quyền cập nhật.",
              "Hệ thống hiển thị thông báo không có quyền và kết thúc use case."
            ]
          }
        ],
        "postconditions": [
          "Mặt hàng mới được lưu vào danh sách Mặt hàng",
          "Dữ liệu nhập không hợp lệ không được lưu",
          "Nhật ký cập nhật hệ thống được ghi lại"
        ]
      }
    },
    {
      "id": "SC_UC02_BanHangTrucTiep",
      "type": "use_case_scenario",
      "title": "Kịch bản Bán hàng trực tiếp tại siêu thị",
      "format": "png",
      "data": {
        "id": "UC-BanHang-TT",
        "useCase": "Bán hàng trực tiếp tại siêu thị",
        "actor": "Nhân viên",
        "preconditions": [
          "Nhân viên đã đăng nhập vào hệ thống QLBH",
          "Nhân viên có quyền bán hàng trực tiếp",
          "Có ít nhất một mặt hàng đang kinh doanh"
        ],
        "mainFlow": [
          "Nhân viên tạo phiên bán hàng mới.",
          "Nhân viên quét mã hoặc chọn mặt hàng cần bán.",
          "Hệ thống hiển thị thông tin và kiểm tra tồn kho của mặt hàng.",
          "Hệ thống thêm mặt hàng vào chi tiết hóa đơn và cập nhật số tiền tạm tính.",
          "Nhân viên lặp lại bước 2 đến 4 cho các mặt hàng khác.",
          "Hệ thống tính tổng tiền cần thanh toán.",
          "Nhân viên xác nhận thông tin khách hàng và hình thức thanh toán.",
          "Hệ thống xác nhận thanh toán thành công.",
          "Hệ thống lưu hóa đơn, cập nhật tồn kho và in hóa đơn."
        ],
        "alternativeFlows": [
          {
            "name": "Không đủ tồn kho",
            "steps": [
              "Tại bước 3, hệ thống phát hiện số lượng bán vượt tồn kho.",
              "Hệ thống hiển thị thông báo không đủ hàng.",
              "Nhân viên giảm số lượng hoặc loại bỏ mặt hàng khỏi giỏ hàng."
            ]
          },
          {
            "name": "Khách hàng là thành viên",
            "steps": [
              "Tại bước 7, nhân viên tra cứu thông tin thành viên.",
              "Hệ thống áp dụng ưu đãi tương ứng cho khách hàng.",
              "Hệ thống cập nhật tổng tiền phải thanh toán."
            ]
          },
          {
            "name": "Thanh toán thất bại",
            "steps": [
              "Tại bước 8, hệ thống không nhận được xác nhận thanh toán.",
              "Hệ thống hiển thị thông báo thanh toán thất bại.",
              "Nhân viên thử lại hình thức thanh toán khác hoặc hủy phiên bán."
            ]
          }
        ],
        "postconditions": [
          "Hóa đơn bán hàng được lưu khi giao dịch thành công",
          "Tồn kho được cập nhật theo số lượng bán",
          "Hóa đơn được in hoặc gửi cho khách hàng"
        ]
      }
    },
